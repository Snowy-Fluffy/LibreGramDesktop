[Desktop Entry]
Name=LibreGram
Comment=New era of messaging
TryExec=Telegram
Exec=Telegram -- %U
Icon=org.libregram.desktop
Terminal=false
StartupWMClass=LibreGram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;tdesktop;libregram;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=Telegram -quit
Name=Quit LibreGram
Icon=application-exit
